{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=administrativo;Username=postgres;Maximum Pool Size=15"
  },
  "Jwt": {
    "Funcionario": {
      "Issuer": "administrativo-local",
      "Audience": "administrativo-local",
      "RequireHttpsMetadata": false
    },
    "Cliente": {
      "Issuer": "administrativo-local",
      "Audience": "administrativo-local",
      "RequireHttpsMetadata": false
    }
  },
  "ServiceAuth": {
    "Key": "local-service-auth-key-change-me"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "service": "administrativo-service"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
