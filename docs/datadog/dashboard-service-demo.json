{
  "title": "[administrativo] dashboard",
  "description": "Dashboard de `administrativo-service`: monitores, APIs (golden metrics), runtime, Pub/Sub/DLQ quando houver, Cloud SQL ou Firestore, e insights de negócio.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Monitores",
        "background_color": "purple",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "manage_status",
              "query": "name:[administrativo]*",
              "display_format": "counts",
              "color_preference": "background",
              "hide_zero_counts": false,
              "show_last_triggered": true,
              "show_priority": true,
              "show_status": true,
              "sort": "status,asc",
              "count": 50,
              "start": 0,
              "summary_type": "monitors",
              "title": "Monitores [administrativo]",
              "title_size": "16",
              "title_align": "left"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APIs (golden metrics)",
        "background_color": "vivid_blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Latência p95 (traffic latency)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p95:trace.aspnet_core.request{service:administrativo-service,env:prod}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Tráfego — hits",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:administrativo-service,env:prod}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Erros",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:administrativo-service,env:prod}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Taxa de erro (errors / hits)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:administrativo-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:administrativo-service,env:prod}.as_count())",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Health hits",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:administrativo-service,env:prod,resource_name:get_/administrativo/health}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top resources — latência p95",
              "type": "toplist",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "q1",
                      "stat": "latency_p95",
                      "service": "administrativo-service",
                      "group_by": [
                        "resource_name"
                      ],
                      "query_filter": "env:prod"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top resources — hits",
              "type": "toplist",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "q1",
                      "stat": "hits",
                      "service": "administrativo-service",
                      "group_by": [
                        "resource_name"
                      ],
                      "query_filter": "env:prod"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top resources — erros",
              "type": "toplist",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "q1",
                      "stat": "errors",
                      "service": "administrativo-service",
                      "group_by": [
                        "resource_name"
                      ],
                      "query_filter": "env:prod"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Aplicação",
        "background_color": "blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Runtime .NET — CPU %",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:runtime.dotnet.cpu.percent{service:administrativo-service,env:prod}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Runtime .NET — memória committed",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:runtime.dotnet.mem.committed{service:administrativo-service,env:prod}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Banco de dados (Cloud SQL)",
        "background_color": "gray",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "CPU utilization",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.cloudsql.database.cpu.utilization{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Memory utilization",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.cloudsql.database.memory.utilization{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Connections",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.cloudsql.database.network.connections{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Disk utilization",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.cloudsql.database.disk.utilization{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
